PORT=4000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/codereviewbuddy?retryWrites=true&w=majority
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-string
ANALYZER_URL=http://localhost:8000
JWT_SECRET=replace-with-at-least-32-random-characters
FRONTEND_URL=http://localhost:5173

GITHUB_APP_ID=replace-with-your-app-id
GITHUB_APP_PRIVATE_KEY_PATH=./crb-app.pem

# Without GITHUB_APP_ID the bot falls back to a personal access token:
# GITHUB_TOKEN=replace-with-your-personal-access-token
